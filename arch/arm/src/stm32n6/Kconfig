if ARCH_CHIP_STM32N6

comment "STM32N6 Configuration Options"

choice
	prompt "STM32 N6 Chip Selection"
	default ARCH_CHIP_STM32N657X0
	depends on ARCH_CHIP_STM32N6

config ARCH_CHIP_STM32N657X0
    bool "STM32N657X0"
    select ARCH_CORTEXM55
    select STM32N6_STM32N6XXXX

endchoice # STM32 N6 Chip Selection

# Chip families:

config STM32N6_STM32N6XXXX
	bool
	default n
	select ARMV8M_HAVE_DCACHE

comment "STM32N6 Peripherals"

menu "STM32N6 Peripheral Selection"

# These "hidden" settings are the OR of individual peripheral selections
# indicating that the general capability is required.

config STM32N6_TIM
	bool
	default n

config STM32N6_SPI
	bool
	default n

config STM32N6_I2C
	bool
	default n

config STM32N6_USART
	bool
	default n

config STM32N6_DMA
	bool
	default n

# These are the peripheral selections proper

menu "STM32H7 Timer Selection"

config STM32N6_TIM1
	bool "TIM1"
	default n
	select STM32N6_TIM

