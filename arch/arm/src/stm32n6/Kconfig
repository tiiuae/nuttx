config STM32N6_XSPI
	bool "STM32N6 XSPI2 controller"
	default n
	select SPI
	---help---
		Enable the experimental N6 XSPI2 QSPI interface scaffold for the
		NUCLEO-N657X0-Q external flash. Transfers are not implemented yet.


menu "STM32N6 DMA Configuration"

config STM32N6_GPDMA1
	bool "Enable GPDMA1"
	select STM32N6_DMA
	select ARCH_DMA
	default n
	---help---
		Enable the 16-channel GPDMA1 controller.

config STM32N6_GPDMA1_NCHANNELS
	int "GPDMA1 channel pool size"
	depends on STM32N6_GPDMA1
	range 1 16
	default 16
	---help---
		Number of low-numbered GPDMA1 channels made available to the DMA
		driver.

config STM32N6_GPDMA1_RESERVED_CHANNELS
	int "GPDMA1 channels reserved from allocation"
	depends on STM32N6_GPDMA1
	range 0 16
	default 0
	---help---
		Number of low-numbered GPDMA1 channels withheld from general
		allocation for board or peripheral reservations.

config STM32N6_HPDMA1
	bool "Enable HPDMA1"
	select STM32N6_DMA
	select ARCH_DMA
	default n
	---help---
		Enable the 16-channel HPDMA1 controller.

config STM32N6_HPDMA1_NCHANNELS
	int "HPDMA1 channel pool size"
	depends on STM32N6_HPDMA1
	range 1 16
	default 16
	---help---
		Number of low-numbered HPDMA1 channels made available to the DMA
		driver.

config STM32N6_HPDMA1_RESERVED_CHANNELS
	int "HPDMA1 channels reserved from allocation"
	depends on STM32N6_HPDMA1
	range 0 16
	default 0
	---help---
		Number of low-numbered HPDMA1 channels withheld from general
		allocation for board or peripheral reservations.

config STM32N6_DMA_DIAGNOSTICS
	bool "DMA diagnostics"
	depends on STM32N6_DMA
	default n
	---help---
		Enable additional diagnostics in the STM32N6 DMA driver.

config STM32N6_DMA_LINKEDLIST
	bool "DMA linked-list support"
	depends on STM32N6_DMA
	default n
	---help---
		Enable linked-list DMA operations.

config STM32N6_DMA_CIRCULAR
	bool "DMA circular operation support"
	depends on STM32N6_DMA_LINKEDLIST
	default n
	---help---
		Enable circular and ping-pong linked-list DMA operations.

endmenu

menu "STM32N6 SPI DMA Configuration"

choice
	prompt "SPI DMA controller"
	depends on STM32N6_SPI
	default STM32N6_SPI_DMA_GPDMA1

config STM32N6_SPI_DMA_GPDMA1
	bool "GPDMA1"
	select STM32N6_GPDMA1

config STM32N6_SPI_DMA_HPDMA1
	bool "HPDMA1"
	select STM32N6_HPDMA1

endchoice

endmenu

menu "STM32N6 USB OTG Configuration"

config STM32N6_OTGDEV
	bool "USB OTG device enable"
	default n
	select USBDEV
	---help---
		Initialize the selected STM32N6 USB controller and integrated
		PHY with bounded waits. The board must supply a qualified HSE
		clock/settling contract. The current Nucleo settling allowance
		is experimental and requires physical qualification.

		Supports control, bulk, and interrupt transfers through the
		integrated FIFO RAM. Connection requires a bound class and an
		explicit, board-qualified VBUS notification. No board GPIO,
		Type-C protection, or VBUS source gates are configured here.

		Only one integrated HS controller can be selected. Host, DMA,
		isochronous, composite, and superspeed configurations are rejected
		at build time. Keep this disabled on operational boards.

if STM32N6_OTGDEV

choice
	prompt "USB device controller"
	default STM32N6_OTG1

config STM32N6_OTG1
	bool "USB1 OTG HS"

config STM32N6_OTG2
	bool "USB2 OTG HS"

endchoice

config STM32N6_OTGDEV_FS
	bool "Force full-speed device operation"
	default y
	---help---
		Use full-speed device mode with the integrated HS PHY for initial
		bring-up. Do not enable USBDEV_DUALSPEED with this option.

config USBDEV_SETUP_MAXDATASIZE
	int "Maximum control OUT payload"
	default 4096
	range 128 65535
	---help---
		Storage for multi-packet control OUT requests, independent of
		EP0's 64-byte packet size. Larger requests are stalled explicitly.
		This buffer is statically allocated; do not increase it unless
		the bound class requires a larger control payload.

endif # STM32N6_OTGDEV

endmenu # STM32N6 USB OTG Configuration

endmenu # STM32N6 Peripheral Selection

endif # ARCH_CHIP_STM32N6
