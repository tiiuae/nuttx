include ${TOPDIR}/.config
include ${TOPDIR}/tools/Config.mk
include ${TOPDIR}/arch/arm/src/armv8-m/Toolchain.defs

# The STM32N657X0 has no internal flash, so the image either runs from SRAM
# where the debugger put it (DEV boot mode), or it is stored in the external
# Octo-SPI NOR on XSPI2 and copied to SRAM at startup.  See the board Kconfig.

ifeq ($(CONFIG_NUCLEO_N657X0_Q_BOOTLOADER),y)
LDSCRIPT = bl_flash.ld
else ifeq ($(CONFIG_NUCLEO_N657X0_Q_BOOT_XSPI),y)
LDSCRIPT = flash.ld
else
LDSCRIPT = sram.ld
endif

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

# Toolchain.defs selects __start by default.  The XIP image must instead
# enter the in-flash relocation stub before __start is present in SRAM.
ifeq ($(CONFIG_NUCLEO_N657X0_Q_BOOT_XSPI),y)
LDFLAGS += --entry=_flash_start
endif

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)$(DELIM)binfmt$(DELIM)libnxflat$(DELIM)gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

# When booting from the external flash, nuttx.bin must carry an STM32 v2.3
# boot header for the boot ROM to accept it.  Wrap it with
# STM32_SigningTool_CLI, which is expected in $(STM32_PRG_PATH), i.e. the
# STM32CubeProgrammer "bin" directory.
#
# The result, nuttx-signed.bin, is what gets programmed at 0x70000000.  If
# STM32_PRG_PATH is unset the step is skipped with a warning so that a plain
# "make" still succeeds on machines without STM32CubeProgrammer installed.

ifneq ($(CONFIG_NUCLEO_N657X0_Q_BOOT_XSPI)$(CONFIG_NUCLEO_N657X0_Q_BOOTLOADER),)

MKIMAGE = $(BOARD_DIR)$(DELIM)tools$(DELIM)mkimage.sh

ifeq ($(CONFIG_NUCLEO_N657X0_Q_BOOTLOADER),y)
# LRUN: the boot ROM copies the payload to the SRAM2 bank base, then enters
# the linked image at _stext (0x34180400).
MKIMAGE_FLAGS = --load 0x34180000
endif

define POSTBUILD
	$(Q) if [ -z "$(STM32_PRG_PATH)" ]; then \
		echo "WARNING: STM32_PRG_PATH is not set; skipping STM32 image packaging."; \
		echo "         nuttx.bin cannot be booted from external flash as-is."; \
	else \
		$(MKIMAGE) -e nuttx -i nuttx.bin -o nuttx-signed.bin $(MKIMAGE_FLAGS) && \
		echo nuttx-signed.bin >> nuttx.manifest; \
	fi
endef

endif
