# CONFIG_NUCLEO_N657X0_Q_USBDEV is not set

CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_USB=y
CONFIG_DEBUG_USB_ERROR=y
CONFIG_DEBUG_USB_WARN=y
CONFIG_USBDEV_TRACE=y
CONFIG_USBDEV_TRACE_STRINGS=y
CONFIG_USBMONITOR=y
CONFIG_USBMONITOR_TRACEINIT=y
CONFIG_USBMONITOR_TRACECLASS=y
CONFIG_USBMONITOR_TRACECONTROLLER=y

CONFIG_NUCLEO_N657X0_Q_I2C2_RISE_TIME_NS=300
CONFIG_NUCLEO_N657X0_Q_I2C2_FALL_TIME_NS=20
CONFIG_NUCLEO_N657X0_Q_I2C2_CLOCK_TOLERANCE_PPM=15000

CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_NUCLEO_N657X0_Q_I2C2=y

