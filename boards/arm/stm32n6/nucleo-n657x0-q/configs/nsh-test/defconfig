CONFIG_RAM_SIZE=4193280
CONFIG_RAM_START=0x34000400
CONFIG_RAW_BINARY=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_CPULOAD_SYSCLK=y
CONFIG_SCHED_WAITPID=y
CONFIG_STM32_DMA_CIRCULAR=y
CONFIG_STM32_DMA_LINKEDLIST=y
CONFIG_STM32_GPDMA1=y
CONFIG_STM32_HPDMA1=y
CONFIG_STM32_I2C2=y
CONFIG_STM32_SPI5=y
CONFIG_STM32_STM32N6XXXX=y
CONFIG_STM32_USART1=y
CONFIG_STM32_USART3=y
CONFIG_SYSTEM_NSH=y
CONFIG_USART1_SERIAL_CONSOLE=y
CONFIG_USART1_TXDMA=y

