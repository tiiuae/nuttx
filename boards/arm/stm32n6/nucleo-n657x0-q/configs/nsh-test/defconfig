CONFIG_NUCLEO_N657X0_Q_DMA_POLICYTEST=y
CONFIG_NUCLEO_N657X0_Q_GPIO_EXTI_TEST=y
CONFIG_NUCLEO_N657X0_Q_TIMER_CLOCKTEST=y
CONFIG_NUCLEO_N657X0_Q_SPI5_BMP280_TEST=y
