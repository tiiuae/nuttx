/****************************************************************************
 * Included Files
 ****************************************************************************/

#include <nuttx/config.h>

#include <errno.h>
#include <stdint.h>

#include <arch/barriers.h>
#include <arch/irq.h>
#include <debug.h>

#include "arm_internal.h"
#include "nvic.h"
#include "hardware/stm32n6xxx_memorymap.h"
#include "hardware/stm32n6xxx_rcc.h"
#include "hardware/stm32n6xxx_uart.h"

#include <stdbool.h>
#include <nuttx/board.h>
#include <arch/board/board.h>

/****************************************************************************
 * Pre-processor Definitions
 ****************************************************************************/

/* The application is signed with a 0x400-byte STM32 v2.3 header at
 * 0x70100000.  Its vector table is the first item in the payload.
 */

#define NSH_XSPI_VECTOR_BASE           0x70100400ul

/* Kernel clock mux registers.  Only CCIPR13 (USART1) is currently declared
 * in hardware/stm32n6xxx_rcc.h, but the XSPI kernel clock selection lives
 * in this same contiguous block, so dump all of them.  CCIPRn is at
 * 0x0144 + 4 * (n - 1); CCIPR13 at 0x0174 matches the arch header.
 */

#define STM32_RCC_CCIPR1               (STM32_RCC_BASE + 0x0144)
#define STM32_RCC_CCIPR_COUNT          14

/* Peripheral clock enable registers.  XSPI1/2/3 and the XSPIM I/O manager
 * sit on AHB5, not in MEMENR (which only covers the SRAM/cache RAMs), so
 * AHB5ENR is the register that says whether XSPI2 is clocked at all.  The
 * arch header does not declare it; the offset follows from the regular
 * RM0486 layout that the declared offsets already match:
 *
 *   0x0250 AHB1ENR   0x0254 AHB2ENR   0x0258 AHB3ENR
 *   0x025c AHB4ENR   0x0260 AHB5ENR   0x0264 APB1ENR1  ...
 *
 * Dump the whole 0x0240..0x027c enable block so the surrounding registers
 * (DIVENR, BUSENR, MISCENR, MEMENR) can be cross-checked in one shot.
 */

#define STM32_RCC_AHB5ENR              (STM32_RCC_BASE + 0x0260)
#define STM32_RCC_AHB5ENSR             (STM32_RCC_BASE + 0x0a60)
#define STM32_RCC_ENR_DUMP_FIRST       0x0240
#define STM32_RCC_ENR_DUMP_LAST        0x027c

/* Sleep-mode clock enables.  The LPENR block mirrors the ENR block at a
 * +0x40 offset (MEMENR 0x24c / MEMLPENR 0x28c, APB2ENR 0x26c / APB2LPENR
 * 0x2ac, ...), so AHB5LPENR follows AHB5ENR at 0x2a0.  Set registers are a
 * further +0x800.
 */

#define STM32_RCC_AHB5LPENR            (STM32_RCC_BASE + 0x02a0)
#define STM32_RCC_AHB5LPENSR           (STM32_RCC_BASE + 0x0aa0)

#define RCC_AHB5LPENR_XSPI2LPEN        (1 << 12)
#define RCC_AHB5LPENR_XSPIMLPEN        (1 << 13)

/* RCC_AHB5ENR bits of interest (RM0486 / CMSIS stm32n657xx.h) */

#define RCC_AHB5ENR_XSPI1EN            (1 << 5)
#define RCC_AHB5ENR_XSPI2EN            (1 << 12)
#define RCC_AHB5ENR_XSPIMEN            (1 << 13)

/* RCC_CCIPR6 XSPI2 kernel clock mux: 0=HCLK5, 1=per_ck, 2=IC3, 3=IC4.
 *
 * IC3 is generated directly from the 800 MHz PLL1 VCO with a divide-by-four
 * ratio.  Selecting it gives XSPI2 its required 200 MHz kernel clock.
 */

#define STM32_RCC_CCIPR6               (STM32_RCC_CCIPR1 + 4 * 5)
#define RCC_CCIPR6_XSPI2SEL_SHIFT      (4)
#define RCC_CCIPR6_XSPI2SEL_MASK       (3 << RCC_CCIPR6_XSPI2SEL_SHIFT)
#define RCC_CCIPR6_XSPI2SEL_CLKP       (1 << RCC_CCIPR6_XSPI2SEL_SHIFT)
#define RCC_CCIPR6_XSPI2SEL_IC3        (2 << RCC_CCIPR6_XSPI2SEL_SHIFT)

#define XSPI_KERNEL_CLOCK_HZ            200000000ul
#define XSPI_FLASH_CLOCK_HZ             200000000ul

/* XSPI1 and the XSPIM I/O manager.  AHB5ENR shows both are clocked by the
 * boot ROM (XSPI1EN and XSPIMEN set, XSPI2EN clear), so unlike XSPI2 these
 * registers can be read without stalling the bus.
 *
 * The question they answer: did the ROM boot this board through the XSPI1
 * controller routed to port 2 by the XSPIM multiplexer?  If so the flash is
 * memory mapped at XSPI1's window (0x90000000), not at 0x70000000.
 */

#define STM32_XSPI1_BASE               0x58025000
#define STM32_XSPIM_CR                 (STM32_XSPIM_BASE + 0x000)

#define STM32_XSPI_CR_OFFSET           0x000
#define STM32_XSPI_DCR1_OFFSET         0x008
#define STM32_XSPI_DCR2_OFFSET         0x00c
#define STM32_XSPI_DCR3_OFFSET         0x010
#define STM32_XSPI_DCR4_OFFSET         0x014
#define STM32_XSPI_SR_OFFSET           0x020
#define STM32_XSPI_FCR_OFFSET          0x024
#define STM32_XSPI_DLR_OFFSET          0x040
#define STM32_XSPI_AR_OFFSET           0x048
#define STM32_XSPI_DR_OFFSET           0x050
#define STM32_XSPI_CCR_OFFSET          0x100
#define STM32_XSPI_TCR_OFFSET          0x108
#define STM32_XSPI_IR_OFFSET           0x110

#define XSPI_CR_EN                     (1 << 0)
#define XSPI_CR_FMODE_SHIFT            (28)
#define XSPI_CR_FMODE_MASK             (3 << XSPI_CR_FMODE_SHIFT)
#define XSPI_CR_FMODE_INDIRECT_WRITE   (0)
#define XSPI_CR_FMODE_INDIRECT_READ    (1)
#define XSPI_CR_FMODE_MEMMAPPED        (3)

#define XSPI_SR_TEF                    (1 << 0)
#define XSPI_SR_TCF                    (1 << 1)
#define XSPI_SR_FTF                    (1 << 2)
#define XSPI_SR_BUSY                   (1 << 5)

#define XSPI_FCR_CTEF                  (1 << 0)
#define XSPI_FCR_CTCF                  (1 << 1)
#define XSPI_FCR_ALL                   (XSPI_FCR_CTEF | XSPI_FCR_CTCF)

#define XSPI_BUSY_TIMEOUT              1000000

/* MX25UM51245G configuration.  The device starts in SPI mode after reset.
 * Change it to DTR octal mode at 50 MHz first, then use its 200 MHz DTR
 * read command in the memory-mapped window.  The flash data sheet requires
 * 20 dummy cycles at 200 MHz and mandates DQS for DTR reads.
 */

#define MX25UM_RDID                    0x9f
#define MX25UM_RDSR                    0x05
#define MX25UM_WREN                    0x06
#define MX25UM_WRCR2                   0x72
#define MX25UM_CR2_MODE                0x00000000ul
#define MX25UM_CR2_DUMMY               0x00000300ul
#define MX25UM_CR2_DOPI                0x02
#define MX25UM_SR_WIP                  (1 << 0)
#define MX25UM_SR_WEL                  (1 << 1)
#define MX25UM_MANUFACTURER            0xc2
#define MX25UM_MEMORY_TYPE             0x80
#define MX25UM_MEMORY_DENSITY          0x3a
#define MX25UM_OCTA_DTR_READ           0xee11
#define MX25UM_READ_DUMMY_CYCLES       20

#define XSPI_DCR1_MX25UM               ((1 << 24) | (25 << 16) | (1 << 8))
#define XSPI_DCR2_SETUP_CLOCK          3
#define XSPI_DCR2_200MHZ_CLOCK         \
  ((XSPI_KERNEL_CLOCK_HZ / XSPI_FLASH_CLOCK_HZ) - 1)

#define XSPI_CCR_IMODE_1LINE           (1 << 0)
#define XSPI_CCR_IMODE_8LINES          (4 << 0)
#define XSPI_CCR_IDTR                  (1 << 3)
#define XSPI_CCR_ISIZE_16BIT           (1 << 4)
#define XSPI_CCR_ADMODE_1LINE          (1 << 8)
#define XSPI_CCR_ADMODE_8LINES         (4 << 8)
#define XSPI_CCR_ADDTR                 (1 << 11)
#define XSPI_CCR_ADSIZE_32BIT          (3 << 12)
#define XSPI_CCR_DMODE_1LINE           (1 << 24)
#define XSPI_CCR_DMODE_8LINES          (4 << 24)
#define XSPI_CCR_DDTR                  (1 << 27)
#define XSPI_CCR_DQSE                  (1 << 29)

#define XSPI_CCR_SPI_COMMAND           XSPI_CCR_IMODE_1LINE
#define XSPI_CCR_SPI_READ              \
  (XSPI_CCR_IMODE_1LINE | XSPI_CCR_DMODE_1LINE)
#define XSPI_CCR_SPI_WRITE             \
  (XSPI_CCR_IMODE_1LINE | XSPI_CCR_ADMODE_1LINE | \
   XSPI_CCR_ADSIZE_32BIT | XSPI_CCR_DMODE_1LINE)
#define XSPI_CCR_MX25UM_DTR_READ       \
  (XSPI_CCR_IMODE_8LINES | XSPI_CCR_IDTR | XSPI_CCR_ISIZE_16BIT | \
   XSPI_CCR_ADMODE_8LINES | XSPI_CCR_ADDTR | XSPI_CCR_ADSIZE_32BIT | \
   XSPI_CCR_DMODE_8LINES | XSPI_CCR_DDTR | XSPI_CCR_DQSE)

/****************************************************************************
 * Private Functions
 ****************************************************************************/

/****************************************************************************
 * Name: stm32_uart_flush_tx
 *
 * Description:
 *   Wait for the console UART to finish shifting its last character before
 *   interrupts are disabled for the application hand-off.
 *
 ****************************************************************************/

static void stm32_uart_flush_tx(void)
{
#ifdef CONFIG_USART1_SERIAL_CONSOLE
  while ((getreg32(STM32_USART1_ISR) & USART_ISR_TC) == 0)
    {
    }
#endif
}

/****************************************************************************
 * Name: stm32_xspi2_set_200mhz_clock
 *
 * Description:
 *   Select the 200 MHz IC3 kernel clock established by the board clock
 *   tree.  IC3 must be configured before RCC_CFGR1 locks the system clock
 *   domains in stm32_stdclockconfig().
 *
 ****************************************************************************/

static void stm32_xspi2_select_200mhz_clock(void)
{
  modifyreg32(STM32_RCC_CCIPR6, RCC_CCIPR6_XSPI2SEL_MASK,
              RCC_CCIPR6_XSPI2SEL_IC3);
  UP_DSB();
}

/****************************************************************************
 * Name: stm32_xspi2_wait
 ****************************************************************************/

static int stm32_xspi2_wait(uint32_t flags)
{
  int timeout;

  for (timeout = XSPI_BUSY_TIMEOUT; timeout > 0; timeout--)
    {
      uint32_t status = getreg32(STM32_XSPI2_BASE + STM32_XSPI_SR_OFFSET);

      if ((status & XSPI_SR_TEF) != 0)
        {
          putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
          return -EIO;
        }

      if ((status & flags) == flags)
        {
          return OK;
        }
    }

  return -ETIMEDOUT;
}

/****************************************************************************
 * Name: stm32_xspi2_wait_any
 ****************************************************************************/

static int stm32_xspi2_wait_any(uint32_t flags)
{
  int timeout;

  for (timeout = XSPI_BUSY_TIMEOUT; timeout > 0; timeout--)
    {
      uint32_t status = getreg32(STM32_XSPI2_BASE + STM32_XSPI_SR_OFFSET);

      if ((status & XSPI_SR_TEF) != 0)
        {
          putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
          return -EIO;
        }

      if ((status & flags) != 0)
        {
          return OK;
        }
    }

  return -ETIMEDOUT;
}

/****************************************************************************
 * Name: stm32_xspi2_wait_idle
 ****************************************************************************/

static int stm32_xspi2_wait_idle(void)
{
  int timeout;

  for (timeout = XSPI_BUSY_TIMEOUT; timeout > 0; timeout--)
    {
      if ((getreg32(STM32_XSPI2_BASE + STM32_XSPI_SR_OFFSET) &
           XSPI_SR_BUSY) == 0)
        {
          return OK;
        }
    }

  return -ETIMEDOUT;
}

/****************************************************************************
 * Name: stm32_xspi2_command
 ****************************************************************************/

static int stm32_xspi2_command(uint32_t instruction)
{
  int ret;

  ret = stm32_xspi2_wait_idle();
  if (ret < 0)
    {
      return ret;
    }

  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  putreg32(XSPI_CCR_SPI_COMMAND,
           STM32_XSPI2_BASE + STM32_XSPI_CCR_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_TCR_OFFSET);
  putreg32(XSPI_CR_EN | (XSPI_CR_FMODE_INDIRECT_WRITE <<
           XSPI_CR_FMODE_SHIFT),
           STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(instruction, STM32_XSPI2_BASE + STM32_XSPI_IR_OFFSET);

  ret = stm32_xspi2_wait(XSPI_SR_TCF);
  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  return ret;
}

/****************************************************************************
 * Name: stm32_xspi2_read
 ****************************************************************************/

static int stm32_xspi2_read(uint32_t instruction, uint8_t *buffer,
                            unsigned int length)
{
  unsigned int i;
  int ret;

  ret = stm32_xspi2_wait_idle();
  if (ret < 0)
    {
      return ret;
    }

  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  putreg32(length - 1, STM32_XSPI2_BASE + STM32_XSPI_DLR_OFFSET);
  putreg32(XSPI_CCR_SPI_READ, STM32_XSPI2_BASE + STM32_XSPI_CCR_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_TCR_OFFSET);
  putreg32(XSPI_CR_EN | (XSPI_CR_FMODE_INDIRECT_READ <<
           XSPI_CR_FMODE_SHIFT),
           STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(instruction, STM32_XSPI2_BASE + STM32_XSPI_IR_OFFSET);

  for (i = 0; i < length; i++)
    {
      ret = stm32_xspi2_wait_any(XSPI_SR_FTF | XSPI_SR_TCF);
      if (ret < 0)
        {
          break;
        }

      buffer[i] = getreg8(STM32_XSPI2_BASE + STM32_XSPI_DR_OFFSET);
    }

  if (ret == OK)
    {
      ret = stm32_xspi2_wait(XSPI_SR_TCF);
    }

  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  return ret;
}

/****************************************************************************
 * Name: stm32_xspi2_write_cr2
 ****************************************************************************/

static int stm32_xspi2_write_cr2(uint32_t address, uint8_t value)
{
  uint8_t status;
  int ret;

  ret = stm32_xspi2_command(MX25UM_WREN);
  if (ret < 0)
    {
      return ret;
    }

  ret = stm32_xspi2_read(MX25UM_RDSR, &status, 1);
  if (ret < 0)
    {
      return ret;
    }

  if ((status & MX25UM_SR_WEL) == 0)
    {
      return -EACCES;
    }

  ret = stm32_xspi2_wait_idle();
  if (ret < 0)
    {
      return ret;
    }

  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_DLR_OFFSET);
  putreg32(XSPI_CCR_SPI_WRITE,
           STM32_XSPI2_BASE + STM32_XSPI_CCR_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_TCR_OFFSET);
  putreg32(XSPI_CR_EN | (XSPI_CR_FMODE_INDIRECT_WRITE <<
           XSPI_CR_FMODE_SHIFT),
           STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(MX25UM_WRCR2, STM32_XSPI2_BASE + STM32_XSPI_IR_OFFSET);
  putreg32(address, STM32_XSPI2_BASE + STM32_XSPI_AR_OFFSET);
  putreg8(value, STM32_XSPI2_BASE + STM32_XSPI_DR_OFFSET);

  ret = stm32_xspi2_wait(XSPI_SR_TCF);
  putreg32(XSPI_FCR_ALL, STM32_XSPI2_BASE + STM32_XSPI_FCR_OFFSET);
  return ret;
}

/****************************************************************************
 * Name: stm32_xspi2_wait_flash_ready
 ****************************************************************************/

static int stm32_xspi2_wait_flash_ready(void)
{
  uint8_t status;
  int timeout;
  int ret;

  for (timeout = XSPI_BUSY_TIMEOUT; timeout > 0; timeout--)
    {
      ret = stm32_xspi2_read(MX25UM_RDSR, &status, 1);
      if (ret < 0)
        {
          return ret;
        }

      if ((status & MX25UM_SR_WIP) == 0)
        {
          return OK;
        }
    }

  return -ETIMEDOUT;
}

/****************************************************************************
 * Name: stm32_xspi2_configure_mx25um
 ****************************************************************************/

static int stm32_xspi2_configure_mx25um(void)
{
  uint8_t id[3];
  int ret;

  ret = stm32_xspi2_read(MX25UM_RDID, id, sizeof(id));
  if (ret < 0)
    {
      return ret;
    }

  if (id[0] != MX25UM_MANUFACTURER || id[1] != MX25UM_MEMORY_TYPE ||
      id[2] != MX25UM_MEMORY_DENSITY)
    {
      return -ENODEV;
    }

  /* DC = 000 selects the 20 dummy cycles required at 200 MHz. */

  ret = stm32_xspi2_write_cr2(MX25UM_CR2_DUMMY, 0);
  if (ret < 0)
    {
      return ret;
    }

  ret = stm32_xspi2_wait_flash_ready();
  if (ret < 0)
    {
      return ret;
    }

  ret = stm32_xspi2_write_cr2(MX25UM_CR2_MODE, MX25UM_CR2_DOPI);
  if (ret < 0)
    {
      return ret;
    }

  /* CR2 writes can take 40 ms.  The next command must use DTR OPI, so it
   * cannot be polled through the SPI status command above.
   */

  up_mdelay(40);
  return OK;
}

/****************************************************************************
 * Name: stm32_xspi2_memorymap
 *
 * Description:
 *   Bring up XSPI2 as the memory-mapped XIP window at 0x70000000.
 *
 *   The boot ROM loads this image over the XSPI1 controller, which it
 *   routes to the port-2 pins by putting XSPIM into swapped mode
 *   (XSPIM_CR.MODE=1), and it leaves XSPI1 in indirect-read mode.  XSPI2
 *   itself is left clock-gated, which is why any access to its registers
 *   or to 0x70000000 stalls the bus until this function has run.
 *
 *   Since the application is linked for XSPI2's window, hand the flash
 *   over to XSPI2 rather than relocating the image to XSPI1's window at
 *   0x90000000:
 *
 *     1. quiesce and disable XSPI1 so it releases the bus
 *     2. enable the XSPI2 bus clock
 *     3. configure IC3 from PLL1 and select it as XSPI2's 200 MHz clock
 *     4. switch XSPIM to direct mode, giving port 2 to XSPI2
 *     5. enter the MX25UM51245G 8DTR mode at a safe setup clock
 *     6. arm its 200 MHz DTR memory-mapped read transaction
 *
 *   The port-2 pins need no attention: the ROM configured them as AF9
 *   (XSPIM_P2), which selects the I/O manager port rather than a specific
 *   controller, so they stay correct across the mux change.
 *
 * Returned Value:
 *   Zero (OK) on success; a negated errno value if XSPI1 never goes idle.
 *
 ****************************************************************************/
static int stm32_xspi2_memorymap(void)
{
  uint32_t cr;
  int ret;
  int timeout;

  /* 1. Wait for the ROM's last XSPI1 transfer to retire, then disable the
   *    controller.  XSPI1 is clocked, so these accesses are safe.
   */

  for (timeout = XSPI_BUSY_TIMEOUT; timeout > 0; timeout--)
    {
      if ((getreg32(STM32_XSPI1_BASE + STM32_XSPI_SR_OFFSET) &
           XSPI_SR_BUSY) == 0)
        {
          break;
        }
    }

  if (timeout == 0)
    {
      _alert("ERROR: XSPI1 stuck busy");
      return -EBUSY;
    }

  cr = getreg32(STM32_XSPI1_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(cr & ~XSPI_CR_EN, STM32_XSPI1_BASE + STM32_XSPI_CR_OFFSET);
  UP_DSB();

  /* 2. Enable the XSPI2 bus clock.  Until this write retires, every XSPI2
   *    access below would stall.
   */

  putreg32(RCC_AHB5ENR_XSPI2EN, STM32_RCC_AHB5ENSR);
  UP_DSB();

  /* The application executes in place from this window and idles in WFI.
   * Without the sleep-mode enables, CSLEEP gates the XSPI2 and XSPIM
   * clocks, the memory-mapped window disappears, and the first instruction
   * fetch after WFI takes a hard fault in the idle task.
   *
   * This is set here, in the code that owns the XSPI2 configuration, and
   * survives into the application: arch/arm/src/stm32n6/stm32_start.c only
   * ever writes the atomic LPENSR set registers, so it cannot clear these
   * bits.
   */

  putreg32(RCC_AHB5LPENR_XSPI2LPEN | RCC_AHB5LPENR_XSPIMLPEN,
           STM32_RCC_AHB5LPENSR);
  UP_DSB();

  /* 3. Configure and select XSPI2's 200 MHz kernel clock. */

  stm32_xspi2_select_200mhz_clock();

  /* 4. Direct mode: XSPI1 -> port 1, XSPI2 -> port 2. */

  putreg32(0, STM32_XSPIM_CR);
  UP_DSB();

  /* 5. Configure SPI transactions at 50 MHz, identify the flash, and
   * enter its octal DTR mode.  The ROM's 0x0b transaction is not valid at
   * 200 MHz and cannot address the entire 64 MiB device.
   */

  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(XSPI_DCR1_MX25UM,
           STM32_XSPI2_BASE + STM32_XSPI_DCR1_OFFSET);
  putreg32(XSPI_DCR2_SETUP_CLOCK,
           STM32_XSPI2_BASE + STM32_XSPI_DCR2_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_DCR3_OFFSET);
  putreg32(0, STM32_XSPI2_BASE + STM32_XSPI_DCR4_OFFSET);
  putreg32(XSPI_CR_EN, STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);

  ret = stm32_xspi2_configure_mx25um();
  if (ret < 0)
    {
      return ret;
    }

  /* 6. Use the Macronix DQS ordering, all four address bytes, and the
   * 200 MHz 8DTRD frame documented for the MX25UM51245G.
   */

  ret = stm32_xspi2_wait_idle();
  if (ret < 0)
    {
      return ret;
    }

  putreg32(XSPI_DCR2_200MHZ_CLOCK,
           STM32_XSPI2_BASE + STM32_XSPI_DCR2_OFFSET);
  putreg32(XSPI_CCR_MX25UM_DTR_READ,
           STM32_XSPI2_BASE + STM32_XSPI_CCR_OFFSET);
  putreg32(MX25UM_READ_DUMMY_CYCLES,
           STM32_XSPI2_BASE + STM32_XSPI_TCR_OFFSET);
  putreg32(MX25UM_OCTA_DTR_READ,
           STM32_XSPI2_BASE + STM32_XSPI_IR_OFFSET);

  cr = XSPI_CR_FMODE_MEMMAPPED << XSPI_CR_FMODE_SHIFT;
  putreg32(cr, STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);
  putreg32(cr | XSPI_CR_EN, STM32_XSPI2_BASE + STM32_XSPI_CR_OFFSET);

  UP_DSB();
  UP_ISB();

  return OK;
}

/****************************************************************************
 * Name: stm32_boot_nsh_xspi
 *
 * Description:
 *   Bring up the XIP window, then install the application's vector table
 *   and branch to its reset handler.  This has the same architectural
 *   effect as a reset into the application.
 *
 ****************************************************************************/

static void __attribute__((noreturn)) stm32_boot_nsh_xspi(void)
{
  const uint32_t *vectors = (const uint32_t *)NSH_XSPI_VECTOR_BASE;
  uint32_t msp;
  uint32_t reset;

  _alert("memory-map XSPI2");

  /* Ensure the last bootloader message is fully drained before handing
   * off to the application; up_irq_disable() below would otherwise race
   * with interrupt-driven UART TX completion.
   */
  stm32_uart_flush_tx();   /* poll USART_ISR.TC (or equivalent) until set */

  up_irq_disable();
  putreg32(0, NVIC_SYSTICK_CTRL);

  /* Do not dereference the application address until this has succeeded.
   * The pointer assignment above is local-only; vectors[0] below causes
   * the first memory-mapped XSPI2 transaction.
   */

  if (stm32_xspi2_memorymap() < 0)
    {
      _alert("ERROR: XSPI2 memory-map failed");
      for (; ; );
    }

  board_userled(BOARD_LED_GREEN, false);
  board_userled(BOARD_LED_BLUE, true);
  msp   = vectors[0];
  board_userled(BOARD_LED_BLUE, false);
  reset = vectors[1];

  putreg32(NSH_XSPI_VECTOR_BASE, NVIC_VECTAB);
  UP_DSB();
  UP_ISB();

  /* bootloader_main() runs in NuttX thread mode, where PSP may be the
   * active stack.  A reset starts with MSP selected, so recreate that state
   * before entering the application's reset handler.
   */

  __asm__ volatile
    (
      "movs r2, #0\n\t"
      "msr control, r2\n\t"
      "isb\n\t"
      "msr msp, %0\n\t"
      "msr psp, r2\n\t"
      "bx %1\n\t"
      :
      : "r" (msp), "r" (reset)
      : "r2", "memory"
    );

  __builtin_unreachable();
}

/****************************************************************************
 * Public Functions
 ****************************************************************************/

/****************************************************************************
 * Name: bootloader_main
 *
 * Description:
 *   Initial NuttX application for the SRAM2-resident bootloader image.
 *
 ****************************************************************************/

int bootloader_main(int argc, char *argv[])
{
  UNUSED(argc);
  UNUSED(argv);
  _alert("start");
  board_userled_initialize();
  board_userled(BOARD_LED_GREEN, true);
  stm32_boot_nsh_xspi();
}
